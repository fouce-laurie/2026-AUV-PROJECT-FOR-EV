<?xml version="1.0"?>
<?xml version="1.0"?>
<package format="3">
  <name>uv_bridge</name>
  <version>1.0.0</version>
  <description>Bridge node between original uv_msgs and micro-ROS zit6_interfaces</description>
  <maintainer email="user@example.com">AUV Team</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>uv_msgs</depend>
  <depend>zit6_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
